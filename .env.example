# Ollama server URL (default: http://localhost:11434)
# Use localhost/127.0.0.1 for local instances (not 0.0.0.0).
# If 0.0.0.0 is set accidentally, the app auto-corrects it to localhost.
# Change this if Ollama is running on another machine (e.g. a Pi on your LAN).
OLLAMA_HOST=http://localhost:11434

# Model to use (default: moondream — tiny 1.7B vision model, Pi-friendly)
# Run:  ollama pull moondream
# Heavier alternatives with better accuracy: llava:7b, llama3.2-vision
OLLAMA_MODEL=moondream
